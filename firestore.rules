rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function memberPath(orgId) { return /databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid); }
    function member(orgId) { return signedIn() && exists(memberPath(orgId)); }
    function role(orgId) { return get(memberPath(orgId)).data.role; }
    function admin(orgId) { return member(orgId) && role(orgId) == 'admin'; }
    function editor(orgId) { return member(orgId) && role(orgId) in ['editor', 'admin']; }
    function canReadProject(orgId, data) {
      return data.visibility == 'public' || admin(orgId) ||
        (member(orgId) && request.auth.uid in data.authorizedUserIds);
    }
    function validProject(data) {
      return data.keys().hasOnly(['title','shortDescription','status','visibility','authorizedUserIds','createdBy','createdAt','updatedAt'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 160
        && data.shortDescription is string && data.shortDescription.size() <= 4000
        && data.status in ['draft','proposed','approved','completed']
        && data.visibility in ['public','private']
        && data.authorizedUserIds is list && data.authorizedUserIds.size() <= 100
        && data.createdBy is string
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false; // Provision user profiles through trusted administration when needed.
    }
    match /organizations/{orgId} {
      allow get: if true; // Only non-sensitive name/labels belong on this document.
      allow list, create, update, delete: if false; // Tenant provisioning is administrative.
      match /members/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || admin(orgId));
        allow list: if admin(orgId);
        allow create, update, delete: if false; // Provision through Firebase Admin SDK.
      }
      match /projects/{projectId} {
        allow get, list: if canReadProject(orgId, resource.data);
        allow create: if editor(orgId) && validProject(request.resource.data)
          && request.resource.data.status == 'draft'
          && request.resource.data.visibility == 'private'
          && request.resource.data.createdBy == request.auth.uid
          && request.auth.uid in request.resource.data.authorizedUserIds
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        // Slice 1: only edit text, not lifecycle, visibility, ownership or ACL.
        allow update: if editor(orgId) && canReadProject(orgId, resource.data)
          && validProject(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','shortDescription','updatedAt'])
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
        match /history/{eventId} {
          allow read: if get(/databases/$(database)/documents/organizations/$(orgId)/projects/$(projectId)).data.visibility == 'public'
            || (signedIn() && canReadProject(orgId, get(/databases/$(database)/documents/organizations/$(orgId)/projects/$(projectId)).data));
          allow write: if false; // Trusted lifecycle operation in slice 3.
        }
      }
    }
  }
}
