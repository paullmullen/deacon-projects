rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isMember(orgId) {
      return request.auth != null && exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.get('status','active') != 'inactive';
    }
    function isOrgAdmin(orgId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role == 'admin'
        && isMember(orgId);
    }
    function canEdit(orgId) {
      return isMember(orgId) && get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role in ['editor', 'admin']
        && get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.get('status', 'active') != 'inactive';
    }
    function canEditProject(orgId, projectId) {
      let member = get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data;
      return request.auth != null && member.get('status', 'active') != 'inactive'
        && (member.role in ['editor', 'admin'] || (member.role == 'special_access'
          && projectId in member.get('projectIds', [])
          && get(/databases/$(database)/documents/organizations/$(orgId)/projects/$(projectId)).data.visibility == 'private'));
    }
    function validBriefFields(data) {
      return (data.get('shortDescription', '') is string && data.get('shortDescription', '').size() <= 500)
        && (data.get('longDescription', '') is string && data.get('longDescription', '').size() <= 4000)
        && (data.get('purpose', '') is string && data.get('purpose', '').size() <= 500)
        && (data.get('leadDeacon', '') is string && data.get('leadDeacon', '').size() <= 160)
        && (data.get('teamMembers', '') is string && data.get('teamMembers', '').size() <= 1000)
        && (data.get('stakeholders', '') is string && data.get('stakeholders', '').size() <= 1000)
        && (data.get('kickoffDate', '') is string && data.get('kickoffDate', '').size() <= 4000)
        && (data.get('targetDate', '') is string && data.get('targetDate', '').size() <= 4000)
        && (data.get('actualDate', '') is string && data.get('actualDate', '').size() <= 4000)
        && (data.get('expectedOutcome', '') is string && data.get('expectedOutcome', '').size() <= 1000)
        && (data.get('deliverables', '') is string && data.get('deliverables', '').size() <= 4000)
        && (!data.keys().hasAny(['assumptionsTable']) || (data.assumptionsTable is list && data.assumptionsTable.size() <= 30))
        && (!data.keys().hasAny(['nextStepsTable']) || (data.nextStepsTable is list && data.nextStepsTable.size() <= 30))
        && (!data.keys().hasAny(['supportingDocuments']) || (data.supportingDocuments is list && data.supportingDocuments.size() <= 20))
        && (!data.keys().hasAny(['deliverableCategories']) || (
          data.deliverableCategories is list
          && data.deliverableCategories.size() <= 7
          && data.deliverableCategories.hasOnly([
            'Research report / assessment',
            'Recommendation / proposal',
            'Project plan',
            'Project management / coordination',
            'Implemented solution',
            'Ongoing operational responsibility',
            'Other'
          ])
        ))
        && (data.get('assumptions', '') is string && data.get('assumptions', '').size() <= 1000)
        && (data.get('barriers', '') is string && data.get('barriers', '').size() <= 1000)
        && (data.get('accomplishments', '') is string && data.get('accomplishments', '').size() <= 4000)
        && (data.get('nextSteps', '') is string && data.get('nextSteps', '').size() <= 2000)
        && (data.get('decisionsNeeded', '') is string && data.get('decisionsNeeded', '').size() <= 1000)
        && (data.get('links', '') is string && data.get('links', '').size() <= 4000)
        && (data.get('projectSponsor', '') is string && data.get('projectSponsor', '').size() <= 500)
        && (data.get('statusNote', '') is string && data.get('statusNote', '').size() <= 100)
        && (data.get('scope', '') is string && data.get('scope', '').size() <= 500)
        && (data.get('nextReviewDate', '') is string && data.get('nextReviewDate', '').size() <= 4000)
        && (data.get('workingDetails', '') is string && data.get('workingDetails', '').size() <= 160);
    }
    function validDashboardFields(data) {
      return (!data.keys().hasAny(['priority']) || data.priority == null ||
        (data.priority is int && data.priority >= 1 && data.priority <= 999999))
        && (!data.keys().hasAny(['deaconRole']) || data.deaconRole in ['leadership', 'representation']);
    }
    function validProjectLead(orgId, data, projectId) {
      return !data.keys().hasAny(['projectLeadUid']) || data.projectLeadUid == '' ||
        (data.projectLeadUid is string && data.projectLeadUid.matches('^[a-zA-Z0-9_-]{1,128}$')
          && (get(/databases/$(database)/documents/organizations/$(orgId)/members/$(data.projectLeadUid)).data.role in ['editor', 'admin']
            || (data.visibility == 'private'
              && get(/databases/$(database)/documents/organizations/$(orgId)/members/$(data.projectLeadUid)).data.role == 'special_access'
              && projectId in get(/databases/$(database)/documents/organizations/$(orgId)/members/$(data.projectLeadUid)).data.get('projectIds', [])))
          && get(/databases/$(database)/documents/organizations/$(orgId)/members/$(data.projectLeadUid)).data.get('status', 'active') != 'inactive');
    }
    // Older unstamped records remain compatible; once stamped, preserve attribution.
    function validEditorStamp(data) {
      return (!resource.data.keys().hasAny(['updatedBy']) || data.keys().hasAll(['updatedBy']))
        && (!data.keys().hasAny(['updatedBy']) || (data.updatedBy == request.auth.uid && data.updatedAt == request.time));
    }
    function validTitle(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 160;
    }
    match /organizations/{orgId} {
      allow get: if true;
      allow list, write: if false;
      match /members/{uid} {
        // Members may see their own membership; tenant admins may manage the roster.
        allow get: if (request.auth != null && request.auth.uid == uid) || isOrgAdmin(orgId);
        allow list: if isOrgAdmin(orgId);
        // Membership creation and changes are handled by trusted Cloud Functions.
        allow create, update, delete: if false;
      }
      match /membershipRequests/{uid} {
        // Applicants may check their own request; tenant admins review all requests.
        allow get: if (request.auth != null && request.auth.uid == uid) || isOrgAdmin(orgId);
        allow list: if isOrgAdmin(orgId);
        // Requests and decisions are handled by trusted Cloud Functions.
        allow create, update, delete: if false;
      }
      match /settings/{settingId} {
        // Tenant email settings are for administrators only.
        allow get: if settingId == 'email' && isOrgAdmin(orgId);
        allow list, create, update, delete: if false;
      }
      match /projects/{projectId} {
        // A shared public brief can be opened at any lifecycle stage.
        allow get: if resource.data.visibility == 'public' || isMember(orgId);
        // Drafts remain excluded from the public portfolio.
        allow list: if (resource.data.visibility == 'public' && resource.data.status in ['proposed', 'active', 'closed']) || isMember(orgId);
        allow create: if canEdit(orgId)
          && request.resource.data.status == 'draft'
          && request.resource.data.visibility == 'private'
          && request.resource.data.createdBy == request.auth.uid
          && validTitle(request.resource.data)
          && validDashboardFields(request.resource.data)
          && validProjectLead(orgId, request.resource.data, projectId);
        allow update: if canEditProject(orgId, projectId)
          && (canEdit(orgId) || (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['visibility','priority'])))
          && validEditorStamp(request.resource.data)
          && resource.data.status != 'closed'
          && resource.data.get('archived', false) == false
          && validTitle(request.resource.data)
          && validDashboardFields(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','shortDescription','longDescription','purpose','leadDeacon','teamMembers','stakeholders','kickoffDate','targetDate','actualDate','expectedOutcome','deliverables','assumptions','barriers','accomplishments','nextSteps','decisionsNeeded','links','projectSponsor','statusNote','scope','nextReviewDate','workingDetails','visibility','updatedAt','progressEditedAt','assumptionsTable','nextStepsTable','deliverableCategories','supportingDocuments','priority','deaconRole','projectLeadUid','updatedBy','attachmentsEditedAt'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['projectLeadUid']) || validProjectLead(orgId, request.resource.data, projectId))
          && request.resource.data.visibility in ['private', 'public']
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['attachmentsEditedAt']) || request.resource.data.attachmentsEditedAt == request.time)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['progressEditedAt']) || request.resource.data.progressEditedAt == request.time)
          && validBriefFields(request.resource.data);
        // Status changes and their history event must be committed atomically.
        allow update: if canEditProject(orgId, projectId)
          && (canEdit(orgId) || (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['visibility','priority'])))
          && validEditorStamp(request.resource.data)
          && resource.data.get('archived', false) == false
          && request.resource.data.lastEventId is string
          && request.resource.data.lastEventId.size() > 0
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status','archived','updatedAt','updatedBy','lastEventId','evaluation','closedBy','closedAt'
          ])
          && request.resource.data.updatedAt == request.time
          && getAfter(/databases/$(database)/documents/organizations/$(orgId)/projects/$(projectId)/history/$(request.resource.data.lastEventId)).data.actorUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/organizations/$(orgId)/projects/$(projectId)/history/$(request.resource.data.lastEventId)).data.fromStatus == resource.data.status
          && getAfter(/databases/$(database)/documents/organizations/$(orgId)/projects/$(projectId)/history/$(request.resource.data.lastEventId)).data.toStatus == request.resource.data.status
          && (
            (resource.data.status == 'draft' && request.resource.data.status == 'proposed'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt','updatedBy','lastEventId']))
            || (resource.data.status == 'proposed' && request.resource.data.status == 'draft'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt','updatedBy','lastEventId']))
            || (resource.data.status == 'proposed' && request.resource.data.status == 'active'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt','updatedBy','lastEventId']))
            || (resource.data.status == 'proposed' && request.resource.data.status == 'proposed'
              && request.resource.data.archived == true
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['archived','updatedAt','updatedBy','lastEventId']))
            || (resource.data.status == 'active' && request.resource.data.status == 'closed'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt','updatedBy','lastEventId','evaluation','closedBy','closedAt'])
              && request.resource.data.closedBy == request.auth.uid
              && request.resource.data.closedAt == request.time
              && request.resource.data.evaluation.outcome in ['Successful','Partially Successful','Unsuccessful','Discontinued']
              && request.resource.data.evaluation.lessonsLearned is string
              && request.resource.data.evaluation.lessonsLearned.size() > 0
              && request.resource.data.evaluation.lessonsLearned.size() <= 4000)
          );
        // Only drafts can be permanently deleted.
        allow delete: if canEditProject(orgId, projectId) && resource.data.status == 'draft';
        match /attachments/{attachmentId} {
          function parentData() { return get(/databases/$(database)/documents/organizations/$(orgId)/projects/$(projectId)).data; }
          function readable() {
            let project = parentData();
            return (isMember(orgId) && get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.get('status','active') != 'inactive')
              || project.visibility == 'public';
          }
          function editable() {
            return canEditProject(orgId, projectId) && parentData().status != 'closed' && parentData().get('archived',false) == false;
          }
          function stamped() {
            let project = getAfter(/databases/$(database)/documents/organizations/$(orgId)/projects/$(projectId)).data;
            return project.attachmentsEditedAt == request.time && project.updatedAt == request.time && project.updatedBy == request.auth.uid;
          }
          allow get, list: if readable();
          allow create: if editable()
            && request.resource.data.keys().hasAll(['name','title','description','size','contentType','uploadedBy','uploadedByName','createdAt','status'])
            && request.resource.data.keys().hasOnly(['name','title','description','size','contentType','uploadedBy','uploadedByName','createdAt','status'])
            && request.resource.data.status == 'uploading'
            && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 240
            && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200
            && request.resource.data.description is string && request.resource.data.description.size() <= 500
            && request.resource.data.size is int && request.resource.data.size > 0 && request.resource.data.size <= 26214400
            && request.resource.data.contentType in ['application/pdf','application/msword','application/vnd.openxmlformats-officedocument.wordprocessingml.document','application/vnd.ms-excel','application/vnd.openxmlformats-officedocument.spreadsheetml.sheet','application/vnd.ms-powerpoint','application/vnd.openxmlformats-officedocument.presentationml.presentation','text/plain','text/csv','image/png','image/jpeg']
            && request.resource.data.uploadedBy == request.auth.uid
            && request.resource.data.uploadedByName is string && request.resource.data.uploadedByName.size() > 0 && request.resource.data.uploadedByName.size() <= 320
            && request.resource.data.createdAt == request.time;
          allow update: if editable() && stamped() && resource.data.uploadedBy == request.auth.uid
            && resource.data.status == 'uploading' && request.resource.data.status == 'ready'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
          allow delete: if canEditProject(orgId, projectId) && (
            (resource.data.status == 'uploading' && resource.data.uploadedBy == request.auth.uid)
            || (editable() && stamped())
          );
        }
        // Notes require editor privileges for this project, separate from viewer read access.
        match /notes/{noteId} {
          allow get, list: if canEditProject(orgId, projectId)
            && exists(/databases/$(database)/documents/organizations/$(orgId)/projects/$(projectId));
          allow create: if noteId != 'current' && canEditProject(orgId, projectId)
            && get(/databases/$(database)/documents/organizations/$(orgId)/projects/$(projectId)).data.status != 'closed'
            && get(/databases/$(database)/documents/organizations/$(orgId)/projects/$(projectId)).data.get('archived', false) == false
            && request.resource.data.keys().hasAll(['body','editorUid','editorName','editedAt'])
            && request.resource.data.keys().hasOnly(['body','editorUid','editorName','editedAt'])
            && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 20000
            && request.resource.data.editorUid == request.auth.uid
            && request.resource.data.editorName is string
            && request.resource.data.editorName.size() > 0 && request.resource.data.editorName.size() <= 320
            && request.resource.data.editedAt == request.time;
          allow update, delete: if false;
        }
        match /history/{eventId} {
          allow get, list: if isMember(orgId);
          allow create: if canEditProject(orgId, projectId)
            && request.resource.data.keys().hasOnly(['action','fromStatus','toStatus','actorUid','at','evaluation'])
            && request.resource.data.keys().hasAll(['action','fromStatus','toStatus','actorUid','at'])
            && request.resource.data.actorUid == request.auth.uid
            && request.resource.data.at == request.time
            && request.resource.data.action in ['propose','withdraw','activate','archive','close']
            && getAfter(/databases/$(database)/documents/organizations/$(orgId)/projects/$(projectId)).data.lastEventId == eventId
            && getAfter(/databases/$(database)/documents/organizations/$(orgId)/projects/$(projectId)).data.status == request.resource.data.toStatus
            && ((request.resource.data.action == 'propose' && request.resource.data.fromStatus == 'draft' && request.resource.data.toStatus == 'proposed')
             || (request.resource.data.action == 'withdraw' && request.resource.data.fromStatus == 'proposed' && request.resource.data.toStatus == 'draft')
             || (request.resource.data.action == 'activate' && request.resource.data.fromStatus == 'proposed' && request.resource.data.toStatus == 'active')
             || (request.resource.data.action == 'archive' && request.resource.data.fromStatus == 'proposed' && request.resource.data.toStatus == 'proposed'
               && getAfter(/databases/$(database)/documents/organizations/$(orgId)/projects/$(projectId)).data.archived == true)
             || (request.resource.data.action == 'close' && request.resource.data.fromStatus == 'active' && request.resource.data.toStatus == 'closed'
               && request.resource.data.evaluation == getAfter(/databases/$(database)/documents/organizations/$(orgId)/projects/$(projectId)).data.evaluation));
          allow update, delete: if false;
        }
      }
    }
  }
}
