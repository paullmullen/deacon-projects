rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isMember(orgId) {
      return request.auth != null && exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }
    function isOrgAdmin(orgId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role == 'admin';
    }
    function canEdit(orgId) {
      return isMember(orgId) && get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role in ['editor', 'admin']
        && get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.get('status', 'active') != 'inactive';
    }
    function validDashboardFields(data) {
      return (!data.keys().hasAny(['priority']) || data.priority == null ||
        (data.priority is int && data.priority >= 1 && data.priority <= 999999))
        && (!data.keys().hasAny(['deaconRole']) || data.deaconRole in ['leadership', 'representation']);
    }
    function validProjectLead(orgId, data) {
      return !data.keys().hasAny(['projectLeadUid']) || data.projectLeadUid == '' ||
        (data.projectLeadUid is string && data.projectLeadUid.matches('^[a-zA-Z0-9_-]{1,128}$')
          && get(/databases/$(database)/documents/organizations/$(orgId)/members/$(data.projectLeadUid)).data.role in ['editor', 'admin']
          && get(/databases/$(database)/documents/organizations/$(orgId)/members/$(data.projectLeadUid)).data.get('status', 'active') != 'inactive');
    }
    function validTitle(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 160;
    }
    match /organizations/{orgId} {
      allow get: if true;
      allow list, write: if false;
      match /members/{uid} {
        // Members may see their own membership; tenant admins may manage the roster.
        allow get: if (request.auth != null && request.auth.uid == uid) || isOrgAdmin(orgId);
        allow list: if isOrgAdmin(orgId);
        // Membership creation and changes are handled by trusted Cloud Functions.
        allow create, update, delete: if false;
      }
      match /membershipRequests/{uid} {
        // Applicants may check their own request; tenant admins review all requests.
        allow get: if (request.auth != null && request.auth.uid == uid) || isOrgAdmin(orgId);
        allow list: if isOrgAdmin(orgId);
        // Requests and decisions are handled by trusted Cloud Functions.
        allow create, update, delete: if false;
      }
      match /settings/{settingId} {
        // Tenant email settings are for administrators only.
        allow get: if settingId == 'email' && isOrgAdmin(orgId);
        allow list, create, update, delete: if false;
      }
      match /projects/{projectId} {
        allow get, list: if isMember(orgId) || (resource.data.visibility == 'public' && resource.data.status in ['proposed', 'active', 'closed']);
        allow create: if canEdit(orgId)
          && request.resource.data.status == 'draft'
          && request.resource.data.visibility == 'private'
          && request.resource.data.createdBy == request.auth.uid
          && validTitle(request.resource.data)
          && validDashboardFields(request.resource.data)
          && validProjectLead(orgId, request.resource.data);
        allow update: if canEdit(orgId)
          && resource.data.status != 'closed'
          && resource.data.get('archived', false) == false
          && validTitle(request.resource.data)
          && validDashboardFields(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','shortDescription','longDescription','purpose','leadDeacon','teamMembers','stakeholders','kickoffDate','targetDate','actualDate','expectedOutcome','deliverables','assumptions','barriers','accomplishments','nextSteps','decisionsNeeded','links','projectSponsor','statusNote','scope','nextReviewDate','workingDetails','visibility','updatedAt','progressEditedAt','assumptionsTable','nextStepsTable','deliverableCategories','supportingDocuments','priority','deaconRole','projectLeadUid'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['projectLeadUid']) || validProjectLead(orgId, request.resource.data))
          && request.resource.data.visibility in ['private', 'public']
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['progressEditedAt']) || request.resource.data.progressEditedAt == request.time)
          && (!request.resource.data.keys().hasAny(['shortDescription']) || (request.resource.data.shortDescription is string && request.resource.data.shortDescription.size() <= 500))
          && (!request.resource.data.keys().hasAny(['longDescription']) || (request.resource.data.longDescription is string && request.resource.data.longDescription.size() <= 4000))
          && (!request.resource.data.keys().hasAny(['purpose']) || (request.resource.data.purpose is string && request.resource.data.purpose.size() <= 500))
          && (!request.resource.data.keys().hasAny(['leadDeacon']) || (request.resource.data.leadDeacon is string && request.resource.data.leadDeacon.size() <= 160))
          && (!request.resource.data.keys().hasAny(['teamMembers']) || (request.resource.data.teamMembers is string && request.resource.data.teamMembers.size() <= 1000))
          && (!request.resource.data.keys().hasAny(['stakeholders']) || (request.resource.data.stakeholders is string && request.resource.data.stakeholders.size() <= 1000))
          && (!request.resource.data.keys().hasAny(['kickoffDate']) || (request.resource.data.kickoffDate is string && request.resource.data.kickoffDate.size() <= 4000))
          && (!request.resource.data.keys().hasAny(['targetDate']) || (request.resource.data.targetDate is string && request.resource.data.targetDate.size() <= 4000))
          && (!request.resource.data.keys().hasAny(['actualDate']) || (request.resource.data.actualDate is string && request.resource.data.actualDate.size() <= 4000))
          && (!request.resource.data.keys().hasAny(['expectedOutcome']) || (request.resource.data.expectedOutcome is string && request.resource.data.expectedOutcome.size() <= 1000))
          && (!request.resource.data.keys().hasAny(['deliverables']) || (request.resource.data.deliverables is string && request.resource.data.deliverables.size() <= 4000))
          && (!request.resource.data.keys().hasAny(['assumptionsTable']) || (request.resource.data.assumptionsTable is list && request.resource.data.assumptionsTable.size() <= 30))
          && (!request.resource.data.keys().hasAny(['nextStepsTable']) || (request.resource.data.nextStepsTable is list && request.resource.data.nextStepsTable.size() <= 30))
          && (!request.resource.data.keys().hasAny(['supportingDocuments']) || (request.resource.data.supportingDocuments is list && request.resource.data.supportingDocuments.size() <= 20))
          && (!request.resource.data.keys().hasAny(['deliverableCategories']) || (
            request.resource.data.deliverableCategories is list
            && request.resource.data.deliverableCategories.size() <= 7
            && request.resource.data.deliverableCategories.hasOnly([
              'Research report / assessment',
              'Recommendation / proposal',
              'Project plan',
              'Project management / coordination',
              'Implemented solution',
              'Ongoing operational responsibility',
              'Other'
            ])
          ))
          && (!request.resource.data.keys().hasAny(['assumptions']) || (request.resource.data.assumptions is string && request.resource.data.assumptions.size() <= 1000))
          && (!request.resource.data.keys().hasAny(['barriers']) || (request.resource.data.barriers is string && request.resource.data.barriers.size() <= 1000))
          && (!request.resource.data.keys().hasAny(['accomplishments']) || (request.resource.data.accomplishments is string && request.resource.data.accomplishments.size() <= 4000))
          && (!request.resource.data.keys().hasAny(['nextSteps']) || (request.resource.data.nextSteps is string && request.resource.data.nextSteps.size() <= 2000))
          && (!request.resource.data.keys().hasAny(['decisionsNeeded']) || (request.resource.data.decisionsNeeded is string && request.resource.data.decisionsNeeded.size() <= 1000))
          && (!request.resource.data.keys().hasAny(['links']) || (request.resource.data.links is string && request.resource.data.links.size() <= 4000))
          && (!request.resource.data.keys().hasAny(['projectSponsor']) || (request.resource.data.projectSponsor is string && request.resource.data.projectSponsor.size() <= 500))
          && (!request.resource.data.keys().hasAny(['statusNote']) || (request.resource.data.statusNote is string && request.resource.data.statusNote.size() <= 100))
          && (!request.resource.data.keys().hasAny(['scope']) || (request.resource.data.scope is string && request.resource.data.scope.size() <= 500))
          && (!request.resource.data.keys().hasAny(['nextReviewDate']) || (request.resource.data.nextReviewDate is string && request.resource.data.nextReviewDate.size() <= 4000))
          && (!request.resource.data.keys().hasAny(['workingDetails']) || (request.resource.data.workingDetails is string && request.resource.data.workingDetails.size() <= 160));
        // Status changes and their history event must be committed atomically.
        allow update: if canEdit(orgId)
          && resource.data.get('archived', false) == false
          && request.resource.data.lastEventId is string
          && request.resource.data.lastEventId.size() > 0
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status','archived','updatedAt','lastEventId','evaluation','closedBy','closedAt'
          ])
          && request.resource.data.updatedAt == request.time
          && getAfter(/databases/$(database)/documents/organizations/$(orgId)/projects/$(projectId)/history/$(request.resource.data.lastEventId)).data.actorUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/organizations/$(orgId)/projects/$(projectId)/history/$(request.resource.data.lastEventId)).data.fromStatus == resource.data.status
          && getAfter(/databases/$(database)/documents/organizations/$(orgId)/projects/$(projectId)/history/$(request.resource.data.lastEventId)).data.toStatus == request.resource.data.status
          && (
            (resource.data.status == 'draft' && request.resource.data.status == 'proposed'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt','lastEventId']))
            || (resource.data.status == 'proposed' && request.resource.data.status == 'draft'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt','lastEventId']))
            || (resource.data.status == 'proposed' && request.resource.data.status == 'active'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt','lastEventId']))
            || (resource.data.status == 'proposed' && request.resource.data.status == 'proposed'
              && request.resource.data.archived == true
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['archived','updatedAt','lastEventId']))
            || (resource.data.status == 'active' && request.resource.data.status == 'closed'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt','lastEventId','evaluation','closedBy','closedAt'])
              && request.resource.data.closedBy == request.auth.uid
              && request.resource.data.closedAt == request.time
              && request.resource.data.evaluation.outcome in ['Successful','Partially Successful','Unsuccessful','Discontinued']
              && request.resource.data.evaluation.lessonsLearned is string
              && request.resource.data.evaluation.lessonsLearned.size() > 0
              && request.resource.data.evaluation.lessonsLearned.size() <= 4000)
          );
        // Only drafts can be permanently deleted.
        allow delete: if canEdit(orgId) && resource.data.status == 'draft';
        // Notes are visible only to editors/admins, separate from public briefs.
        match /notes/{noteId} {
          allow get, list: if canEdit(orgId)
            && exists(/databases/$(database)/documents/organizations/$(orgId)/projects/$(projectId));
          allow create: if noteId != 'current' && canEdit(orgId)
            && get(/databases/$(database)/documents/organizations/$(orgId)/projects/$(projectId)).data.status != 'closed'
            && get(/databases/$(database)/documents/organizations/$(orgId)/projects/$(projectId)).data.get('archived', false) == false
            && request.resource.data.keys().hasAll(['body','editorUid','editorName','editedAt'])
            && request.resource.data.keys().hasOnly(['body','editorUid','editorName','editedAt'])
            && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 20000
            && request.resource.data.editorUid == request.auth.uid
            && request.resource.data.editorName is string
            && request.resource.data.editorName.size() > 0 && request.resource.data.editorName.size() <= 320
            && request.resource.data.editedAt == request.time;
          allow update, delete: if false;
        }
        match /history/{eventId} {
          allow get, list: if isMember(orgId);
          allow create: if canEdit(orgId)
            && request.resource.data.keys().hasOnly(['action','fromStatus','toStatus','actorUid','at','evaluation'])
            && request.resource.data.keys().hasAll(['action','fromStatus','toStatus','actorUid','at'])
            && request.resource.data.actorUid == request.auth.uid
            && request.resource.data.at == request.time
            && request.resource.data.action in ['propose','withdraw','activate','archive','close']
            && getAfter(/databases/$(database)/documents/organizations/$(orgId)/projects/$(projectId)).data.lastEventId == eventId
            && getAfter(/databases/$(database)/documents/organizations/$(orgId)/projects/$(projectId)).data.status == request.resource.data.toStatus
            && ((request.resource.data.action == 'propose' && request.resource.data.fromStatus == 'draft' && request.resource.data.toStatus == 'proposed')
             || (request.resource.data.action == 'withdraw' && request.resource.data.fromStatus == 'proposed' && request.resource.data.toStatus == 'draft')
             || (request.resource.data.action == 'activate' && request.resource.data.fromStatus == 'proposed' && request.resource.data.toStatus == 'active')
             || (request.resource.data.action == 'archive' && request.resource.data.fromStatus == 'proposed' && request.resource.data.toStatus == 'proposed'
               && getAfter(/databases/$(database)/documents/organizations/$(orgId)/projects/$(projectId)).data.archived == true)
             || (request.resource.data.action == 'close' && request.resource.data.fromStatus == 'active' && request.resource.data.toStatus == 'closed'
               && request.resource.data.evaluation == getAfter(/databases/$(database)/documents/organizations/$(orgId)/projects/$(projectId)).data.evaluation));
          allow update, delete: if false;
        }
      }
    }
  }
}
